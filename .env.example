# Copy this file to ".env" and fill in what you need.
# Search/retrieval works WITHOUT any of these.

# --- Translation (FREE, recommended) ----------------------------------------
# Fluent, scholarly English translation uses a free LLM. Get a free Gemini key
# (no credit card) at https://aistudio.google.com/apikey and paste it here.
# Without a key, translation falls back to the local NLLB model (rough "gist").
GEMINI_API_KEY=

# Alternatives (also free) — set IKE_TRANSLATE_PROVIDER and the matching key:
#   IKE_TRANSLATE_PROVIDER=groq         + GROQ_API_KEY=...        (Llama 3.3 70B)
#   IKE_TRANSLATE_PROVIDER=openrouter   + OPENROUTER_API_KEY=...  (free models)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- HuggingFace token (optional) -------------------------------------------
# Only removes the "unauthenticated requests" warning and speeds up model
# downloads. A "Read" token is enough. Models are already cached, so optional.
# HF_TOKEN=hf_...


# --- Option A (recommended): Claude for answers + translation ---------------
ANTHROPIC_API_KEY=sk-ant-...

# Model: claude-sonnet-4-6 (default, cheap) or claude-opus-4-8 (max quality)
# IKE_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Option B: fully local, zero cloud (requires Ollama installed) -----------
# IKE_LLM_PROVIDER=ollama
# IKE_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Qur'an translation (optional) -------------------------------------------
# The site ships Saheeh International in data/raw/quran_en.json and needs
# nothing here. Quran.com's own default, Dr. Mustafa Khattab's The Clear
# Qur'an, is licensed and served only to a registered client. Get credentials
# free at https://api-docs.quran.foundation/request-access/ and fetch it with
#   .venv\Scripts\python scripts\fetch_quran_translation.py
# QURAN_CLIENT_ID=
# QURAN_CLIENT_SECRET=

# --- Corpus scope ------------------------------------------------------------
# Which volume to index (1-37). Leave as 1 for the MVP; set empty/remove and
# edit config.TARGET_VOLUME=None to index all volumes.
# IKE_TARGET_VOLUME=1
